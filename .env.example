# Nested settings use double-underscore env names.
SMOKE_QUERY__TOP_K=5
PARSER__PROFILE=ocr_fallback
PARSER__OCR_LANG=eng
CHUNK__STRATEGY_ID=section_aware
CHUNK__TARGET_TOKENS=400
CHUNK__OVERLAP_RATIO=0.12
EMBED__MODEL_ID=BAAI/bge-m3
EMBED__DEVICE=auto
EMBED__BATCH_SIZE=16
# ~4 GiB GPU: use small model (auto also switches below 6 GiB VRAM)
# EMBED__MODEL_ID=BAAI/bge-small-en-v1.5
# EMBED__BATCH_SIZE=4
# OpenAI / Cohere (API) — only needed when those embed providers are selected
# OPENAI_API_KEY=
# COHERE_API_KEY=

# Default store for CLI (Streamlit selector defaults to this too).
# chroma = local disk | weaviate = local Docker or cloud | pinecone = API
VECTOR_STORE=chroma
CHROMA__PERSIST_DIR=artifacts/indexes/chroma

# Weaviate — docker compose up -d  then  uv sync --extra weaviate
WEAVIATE__URL=http://localhost:8080
WEAVIATE__GRPC_PORT=50051
# WEAVIATE__API_KEY=

# Pinecone (API) — uv sync --extra pinecone ; required when VECTOR_STORE=pinecone
# PINECONE__API_KEY=
PINECONE__INDEX_NAME=ragroog
PINECONE__CLOUD=aws
PINECONE__REGION=us-east-1
