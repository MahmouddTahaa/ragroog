# Frozen winning lab combination — product UI will load this later.
# Generated by Compare tab / freeze_combo(). Do not treat as the Streamlit lab UI.
parser_engine: pymupdf
parser_profile: ocr_fallback
chunk:
  strategy_id: section_aware
  target_tokens: 400
  overlap_ratio: 0.12
embed:
  model_id: BAAI/bge-small-en-v1.5
vector_store: chroma
retrieval:
  mode: dense
  top_k: 5
